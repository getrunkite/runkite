# Copy to .env.llm (gitignored) and fill in. Never commit .env.llm.
#
#   cp .env.llm.example .env.llm
#
# Used by examples/gemini_* and bench/llm/.

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0

# Soft spend guard for bench/llm (USD). Harness stops when estimated spend exceeds this.
LLM_BUDGET_USD=150
LLM_COST_PER_1K_INPUT_USD=0.0001
LLM_COST_PER_1K_OUTPUT_USD=0.0004
