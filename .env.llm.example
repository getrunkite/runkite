# Copy to `.env.llm` (gitignored) and fill in. Never commit `.env.llm`.
#
#   cp .env.llm.example .env.llm
#
# Or set RUNKITE_LLM_ENV to any env file path outside the repo.
# Used by examples/gemini/* , dogfood/start.sh, and bench/llm/.

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0

# Optional — when you adapt examples to other providers:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Soft spend guard for bench/llm (USD).
LLM_BUDGET_USD=150
LLM_COST_PER_1K_INPUT_USD=0.0001
LLM_COST_PER_1K_OUTPUT_USD=0.0004
