# Copy this file to .env and fill in real values before running
# docker-compose.yml (or docker-compose.multi.yml). Both files require
# these -- no built-in fallback -- so a forgotten or copy-pasted secret
# fails loudly at `docker compose up` instead of silently deploying with
# a well-known password or a shared placeholder token.
#
#   cp .env.example .env

# Postgres password for the control plane's own database (docker-compose.yml
# only -- docker-compose.multi.yml is a local dev/test topology and keeps a
# fixed password since it never leaves the machine it runs on).
POSTGRES_PASSWORD=

# Shared secret runners present on every gRPC call and /internal/* HTTP
# request. Generate one with, e.g.: openssl rand -hex 32
RUNNER_TOKEN=

# Optional: enable /debug/pprof/* only when BOTH are set.
# RUNKITE_PPROF=1
# RUNKITE_PPROF_TOKEN=
