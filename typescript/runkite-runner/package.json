{
  "name": "runkite-runner",
  "version": "1.0.0",
  "description": "Runkite Runner Protocol SDK for TypeScript/LangGraph.js -- connects to a Runkite control plane, executes LangGraph.js agents, and streams events back. TypeScript/Node equivalent of the Python runner (runkite_runner), proving the Runner Protocol is genuinely language-agnostic.",
  "type": "module",
  "bin": {
    "runkite-runner": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "oxlint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "pg": "^8.22.0",
    "tsx": "^4.23.1",
    "undici": "^8.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
