# Go (root binary only -- not deploy/helm/runkite or other paths)
/runkite
*.db
*.db-shm
*.db-wal

# Node (admin-ui, typescript/runkite-runner)
node_modules/
*.tsbuildinfo

# internal/adminui/dist is the Admin UI's built output and IS committed
# (see internal/adminui/adminui.go's doc comment) so `go build` never
# needs npm -- do not ignore it here.

# Editors / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
# Cursor IDE project rules — local only, not part of the product tree
.cursor/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
python/dist/
python/build/
*.tgz

# GoReleaser local artifacts
/dist/

# Local env
.env

# Local secrets / LLM keys -- NEVER commit. Prefer .env.llm for Gemini
# and related provider keys used by bench/llm and examples/gemini_*.
.env.*
!.env.example
!.env.llm.example

# Local LLM matrix / experiment artifacts (may contain prompts/responses)
bench/llm/out/
plans/llm/
.venv/

# Internal design diaries / dogfooding notes -- not for the public tree.
# Contains product-migration narrative that must not ship.
plans/

# Founder-private deep product walkthroughs (not for the public tree).
explain_in_details/

# Employer-internal agent clones + local multi-agent Runkite demo.
# Corporate code -- must never ship to the public Runkite tree.
rh-agents-demo/

# External audit reports: itemized lists of exactly what's insecure/
# broken right now, useful while triaging but a real disclosure-timing
# risk to publish before the findings are actually fixed.
CODE_REVIEW_ANALYSIS*.md

# Local LLM review write-ups (same disclosure-timing class as the
# CODE_REVIEW_ANALYSIS files). Keep them on disk; never `git add .` them.
reviews/

# Unpublished launch copy (Show HN / Reddit / X). A single filename
# (announce-v0.3-draft.md) is not enough — the next version bump would
# create announce-v0.4-draft.md and `git add docs/` would ship it again.
docs/announce*.md
*announce*-draft.md

# Soak run artifacts (logs, metrics snapshots, REPORT.md)
bench/soak/out/*/
examples/gemini/**/node_modules/

# Local screenshot scratch
.tmp-admin-shots/
